generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("CUSTOMER") // ARTIST | CUSTOMER
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  artistProfile ArtistProfile?
  appointments  Appointment[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]
  messages      Message[]
  flashTattoos  FlashTattoo[]
}

model ArtistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  studioName      String?
  city            String?
  district        String?
  address         String?
  experienceYears Int      @default(0)
  minPrice        Int      @default(0)
  maxPrice        Int      @default(0)
  phone           String?
  instagram       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  styles        ArtistStyle[]
  portfolioItems PortfolioItem[]
  appointments  Appointment[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]
  flashTattoos  FlashTattoo[]
  feedPosts     FeedPost[]
  expenses      Expense[]
}

model TattooStyle {
  id     String @id @default(cuid())
  name   String @unique
  slug   String @unique

  artists ArtistStyle[]
}

model ArtistStyle {
  artistProfileId String
  tattooStyleId   String

  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  tattooStyle   TattooStyle   @relation(fields: [tattooStyleId], references: [id], onDelete: Cascade)

  @@id([artistProfileId, tattooStyleId])
}

model PortfolioItem {
  id              String   @id @default(cuid())
  artistProfileId String
  imageUrl        String
  title           String?
  description     String?
  styleName       String?
  createdAt       DateTime @default(now())

  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String   @id @default(cuid())
  customerId      String
  artistProfileId String
  status          String   @default("PENDING") // PENDING | APPROVED | DEPOSIT_PAID | REJECTED | COMPLETED | CANCELLED
  depositAmount   Int?     @default(0)
  depositPaid     Boolean  @default(false)
  requestedDate   DateTime
  description     String?
  referenceImage  String?
  notes           String?
  bodyPart        String?  // e.g., "Kol", "Sırt"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  review        Review?
}

model Review {
  id              String   @id @default(cuid())
  customerId      String
  artistProfileId String
  appointmentId   String?  @unique
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model Favorite {
  customerId      String
  artistProfileId String
  createdAt       DateTime @default(now())

  customer      User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  @@id([customerId, artistProfileId])
}

model Conversation {
  id              String    @id @default(cuid())
  customerId      String
  artistProfileId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([customerId, artistProfileId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model FlashTattoo {
  id              String   @id @default(cuid())
  artistProfileId String
  title           String
  description     String?
  imageUrl        String
  price           Int
  size            String?  // e.g., "10x10 cm"
  bodyPart        String?  // e.g., "Kol", "Bacak"
  isAvailable     Boolean  @default(true)
  buyerId         String?  // If someone reserves it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  buyer           User?         @relation(fields: [buyerId], references: [id], onDelete: SetNull)
}

model FeedPost {
  id              String   @id @default(cuid())
  artistProfileId String
  imageUrl        String
  caption         String?
  bodyPart        String?
  likes           Int      @default(0)
  createdAt       DateTime @default(now())

  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String   @id @default(cuid())
  artistProfileId String
  title           String
  amount          Int
  category        String   // e.g., "Malzeme", "Kira", "Reklam"
  date            DateTime @default(now())

  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
}
