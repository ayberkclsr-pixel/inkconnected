# Database (PostgreSQL - e.g. Vercel Postgres, Supabase, Neon, Railway)
DATABASE_URL="postgresql://username:password@hostname:5432/databasename?sslmode=require"

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-strong-random-secret-e.g-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.vercel.app"

# AI Advisor & Tattoo Match (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key"
